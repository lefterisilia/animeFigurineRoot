{
  "expo": {
    "name": "animeFigurine",
    "slug": "animeFigurine",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "animefigurine",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lefterisilia2003.animeFigurine"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [ "@reactvision/react-viro",
        {
          "android": {
            "xRMode": "AR"
          }
        }
          ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f2862cd5-4c21-4173-851d-fe1b4b3dc0f2"
      }
    },
    "owner": "lefterisilia2003"
  }
}
